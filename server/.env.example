# ==========================================
# SERVER (BACKEND API) ENVIRONMENT CONFIG
# ==========================================

# Environment Mode (production / development / test)
NODE_ENV=production
PORT=5000

# MongoDB Connection String (Atlas Replica Set recommended in production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/my-canteen?retryWrites=true&w=majority
# MONGODB_URI is also accepted as a provider alias

# Frontend Allowed Origins (Strict CORS)
CLIENT_URL=https://YOUR_DOMAIN
ADMIN_URL=https://admin.YOUR_DOMAIN
ALLOWED_ORIGINS=https://YOUR_DOMAIN,https://admin.YOUR_DOMAIN

# Authentication Secrets (Generate 32+ characters high entropy string)
JWT_SECRET=your_production_jwt_secret_must_be_random_and_secret
JWT_EXPIRES_IN=7d

# Payment Gateway Secrets (Razorpay)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_live_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_signing_secret

# Cloudinary Image Hosting Config
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

